#!/bin/sh
# KodacyOS: triggerhappy watches the power button (and later the kill combo of
# the input follow-up plan). Replaces Batocera's S50triggerhappy, which sourced
# the D-Bus and multimedia-key machinery we do not ship.

NAME=thd
DAEMON=/usr/sbin/$NAME
PIDFILE=/var/run/$NAME.pid
CONF=/etc/triggerhappy/triggers.d/kodacy.conf
# a custom conf on the card wins, like Batocera's /userdata/system/configs/multimedia_keys.conf
[ -e /userdata/system/configs/kodacy-triggers.conf ] && CONF=/userdata/system/configs/kodacy-triggers.conf
DAEMON_ARGS="--daemon --triggers $CONF --socket /var/run/thd.socket --pidfile $PIDFILE /dev/input/event*"

test -x $DAEMON || exit 0

case "$1" in
	start)
		printf "Starting $NAME: "
		start-stop-daemon --start --quiet --pidfile $PIDFILE --exec $DAEMON -- $DAEMON_ARGS \
			&& echo "OK" || echo "FAIL"
		;;
	stop)
		printf "Stopping $NAME: "
		start-stop-daemon --stop --quiet --pidfile $PIDFILE && echo "OK" || echo "FAIL"
		;;
	restart)
		"$0" stop
		sleep 1
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
esac
