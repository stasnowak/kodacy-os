config BR2_PACKAGE_LOVE
	bool "love"
	depends on !BR2_STATIC_LIBS # luajit
	depends on BR2_PACKAGE_BATOCERA_LUAJIT_ARCH_SUPPORTS
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_BATOCERA_LUAJIT
	select BR2_PACKAGE_SDL2
	select BR2_PACKAGE_OPENAL
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_LIBMODPLUG
	select BR2_PACKAGE_LIBOGG
	select BR2_PACKAGE_LIBVORBIS
	select BR2_PACKAGE_LIBTHEORA
	select BR2_PACKAGE_MPG123
	select BR2_PACKAGE_ZLIB
	help
	  LÖVE 11.5 "Mysterious Mysteries": the runtime Kodacy games and the
	  Kodacy launcher (kodacy.love) run on. Rendering goes through SDL2
	  (KMS/DRM without a compositor, Wayland under labwc) to OpenGL ES 2
	  on Mesa Panfrost. LuaJIT is Batocera's OpenResty fork, the one the
	  rest of the tree already builds.

	  https://love2d.org

comment "love needs a toolchain w/ C++, threads, dynamic library"
	depends on BR2_PACKAGE_BATOCERA_LUAJIT_ARCH_SUPPORTS
	depends on !BR2_INSTALL_LIBSTDCPP || !BR2_TOOLCHAIN_HAS_THREADS || BR2_STATIC_LIBS
