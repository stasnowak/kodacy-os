# KodacyOS common board config (Phase 7 of plans/kodacy-os.md in kodacy-studio).
# Started as a copy of configs/batocera-board.common; everything Batocera
# selected for emulation, media or the desktop is gone and the system package
# is package/kodacy/kodacy-system (see docs/dependencies.md for every keep).
-include batocera-board.local.common

# users
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/users.txt"

# toolchain definition (as upstream)
BR2_OPTIMIZE_2=y
BR2_ENABLE_LTO=y
BR2_SHARED_STATIC_LIBS=y
BR2_GCC_ENABLE_GRAPHITE=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# required for utf-8
BR2_TOOLCHAIN_GLIBC_GCONV_LIBS_COPY=y

# GNU userland instead of busybox, as upstream (the init scripts rely on it)
BR2_PACKAGE_BUSYBOX=n
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_DIFFUTILS=y
BR2_PACKAGE_FINDUTILS=y
BR2_PACKAGE_GAWK=y
BR2_PACKAGE_GREP=y
BR2_PACKAGE_GZIP=y
BR2_PACKAGE_IFUPDOWN=y
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_NCURSES_TARGET_PROGS=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_PSMISC=y
BR2_PACKAGE_SED=y
BR2_PACKAGE_START_STOP_DAEMON=y
BR2_PACKAGE_TAR=y
BR2_PACKAGE_UTIL_LINUX_AGETTY=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_HWCLOCK=y
BR2_PACKAGE_UTIL_LINUX_KILL=y
BR2_PACKAGE_UTIL_LINUX_LOGGER=y
BR2_PACKAGE_UTIL_LINUX_LOGIN=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_UTIL_LINUX_FALLOCATE=y
BR2_PACKAGE_WHICH=y

# system
BR2_TARGET_GENERIC_HOSTNAME="kodacy"
BR2_TARGET_GENERIC_ISSUE="KodacyOS"
BR2_INIT_SYSV=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_TARGET_GENERIC_ROOT_PASSWD="linux"
BR2_SYSTEM_ENABLE_NLS=y
BR2_ENABLE_LOCALE_WHITELIST="C en_US pl_PL"
BR2_GENERATE_LOCALE="en_US.UTF-8 pl_PL.UTF-8"
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Europe/Warsaw"
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_SYSTEM_BIN_SH_DASH=y # /bin/sh implementation; a `choice` cannot be `select`ed from a Config.in
BR2_PACKAGE_DROPBEAR_LOCALOPTIONS_FILE="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/dropbear_localoptions.h"

# Initramfs decompression support
BR2_LINUX_KERNEL_LZ4=y

# KodacyOS: the system selection (package/kodacy/kodacy-system) brings the
# hardware template's infrastructure, Mesa Panfrost + SDL2, LÖVE 11.5
# (package/kodacy/love) and the launcher (package/kodacy/kodacy-launcher).
BR2_PACKAGE_KODACY_SYSTEM=y
# Panfrost needs MESA3D_LLVM in this buildroot, which switches OpenCL on by
# default; LÖVE does not use OpenCL and libclc is a long build.
BR2_PACKAGE_MESA3D_OPENCL=n

# Disable generating rootfs tar (speedup)
BR2_TARGET_ROOTFS_TAR=n

# images: Batocera's scripts first, ours second
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/scripts/post-build-script.sh $(BR2_EXTERNAL_BATOCERA_PATH)/board/kodacy/scripts/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_BATOCERA_PATH)/board/batocera/scripts/post-image-script.sh $(BR2_EXTERNAL_BATOCERA_PATH)/board/kodacy/scripts/post-image.sh"

# Enables ccache
BR2_CCACHE=y

# Don't purge locales
BR2_ENABLE_LOCALE_PURGE=n
